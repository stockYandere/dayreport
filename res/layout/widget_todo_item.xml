<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="10dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingEnd="8dp"
        android:textColor="#F2F2EC"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/item_done"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/widget_done"
        android:contentDescription="완료"
        android:gravity="center"
        android:text="O"
        android:textColor="#A8D8A0"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/item_skip"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="7dp"
        android:background="@drawable/widget_skip"
        android:contentDescription="안 함"
        android:gravity="center"
        android:text="X"
        android:textColor="#E3A49C"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
